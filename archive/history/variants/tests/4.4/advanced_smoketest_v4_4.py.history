import json
import shutil
import subprocess
import tempfile
from pathlib import Path

from audioknigi_v44 import AudioKnigiApp, Book, Track

ffmpeg = shutil.which('ffmpeg')
ffprobe = shutil.which('ffprobe')
if not ffmpeg or not ffprobe:
    raise SystemExit('Нужны ffmpeg/ffprobe')

root = Path(tempfile.mkdtemp(prefix='audioknigi_v44_advanced_'))
base = root / 'incoming'
base.mkdir()
source = root / 'source64mono.mp3'
subprocess.run([
    ffmpeg, '-y', '-f', 'lavfi', '-i', 'sine=frequency=500:duration=5',
    '-ac', '1', '-c:a', 'libmp3lame', '-b:a', '64k', str(source)
], check=True, stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)

app = AudioKnigiApp()
app.runtime_output_dir = str(base)
app.runtime_output_mode = 'both'
app.runtime_audio_preset = '128k_stereo'
app.runtime_normalization_mode = 'two_pass'
app.runtime_normalize_audio = True
app.runtime_embed_tags = True
app.runtime_delete_source = False
app.runtime_save_sidecars = True
app.runtime_use_templates = True
app.runtime_folder_template = '{Author}/{Book_Title} ({Year})'
app.runtime_track_template = '{Track_Number} - {Track_Title}.mp3'
app.runtime_abs_enabled = False
app.runtime_parallel_single_source = False
app.runtime_segment_count = 'auto'
app.runtime_bandwidth_limit = 0

url='https://example.invalid/source.mp3'
tracks=[
    Track(index=1,title='Начало',file=url,start=0,end=2.5,duration=2.5),
    Track(index=2,title='Финал',file=url,start=2.5,end=5,duration=2.5),
]
book=Book(
    url='https://audioknigi.com.ua/test', title='Тестовая книга', author='Автор Тест',
    narrator='Диктор Тест', description='Описание тестовой книги.', genre='Детектив', year='2026',
    tracks=tracks,
)
folder=app._book_folder(book)
local_source=folder/'_source.mp3'
shutil.copy2(source, local_source)
app._process_book(book, [1,2])

assert folder == base/'Автор Тест'/'Тестовая книга (2026)', folder
assert (folder/'01 - Начало.mp3').exists()
assert (folder/'02 - Финал.mp3').exists()
assert (folder/'Тестовая книга.m4b').exists()
assert (folder/'book_info.txt').exists()
assert (folder/'metadata.json').exists()
meta=json.loads((folder/'metadata.json').read_text(encoding='utf-8'))
assert meta['narrator']=='Диктор Тест'
assert meta['genre']=='Детектив'

# Smart Format target must not raise source 64k mono to 128k stereo.
info=app._probe_audio_info(folder/'01 - Начало.mp3')
assert int(info.get('channels') or 0) == 1, info
assert int(info.get('bit_rate') or 0) <= 90000, info

try:
    from mutagen.mp4 import MP4
    tags=MP4(str(folder/'Тестовая книга.m4b')).tags
    assert tags.get('\xa9nam',[None])[0]=='Тестовая книга'
    assert tags.get('\xa9ART',[None])[0]=='Автор Тест'
    assert tags.get('\xa9gen',[None])[0]=='Детектив'
    assert tags.get('\xa9day',[None])[0]=='2026'
except Exception as e:
    raise AssertionError(f'M4B tags failed: {e}')

print('TEMPLATE ENGINE: OK')
print('TWO-PASS LOUDNORM: OK')
print('SMART FORMAT MATCH: OK')
print('SIDECAR METADATA: OK')
print('M4B TAGS: OK')
print('ADVANCED SMOKETEST: OK')
app.destroy()
