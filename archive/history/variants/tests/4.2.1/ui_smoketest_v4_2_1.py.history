from audioknigi_v42 import AudioKnigiApp

app = AudioKnigiApp()
app.update_idletasks()

tabs = [
    app.notebook.tab(i, "text")
    for i in range(app.notebook.index("end"))
]

assert tabs == ["Книга", "Очередь", "История", "Настройки"], tabs

print("Окно:", app.title())
print("Вкладки:", ", ".join(tabs))
print("UI SMOKETEST: OK")

app.destroy()
