+def _connect_target_with_info(host: str, port: int, timeout: float = 12.0):
+    """Connect via the configured policy, returning socket and safe route details.
+
+    AUTO: prefer Cloudflare DoH; if TCP cannot reach its addresses, try
+    *different* system-DNS addresses. DNS selection is not a VPN, and a timeout
+    on the same IP cannot be fixed by simply changing DNS providers.
+
+    A total connection deadline limits retries. STRICT Cloudflare never uses
+    the system resolver; a configured upstream proxy always takes precedence.
+    """
+    timeout = max(0.1, float(timeout))
+    started = time.monotonic()
+    details = {"dns_provider": "", "address": "", "dns_ms": 0,
+               "tcp_ms": 0, "attempts": 0, "alternate_attempted": False}
