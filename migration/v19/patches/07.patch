+            if remaining <= 0:
+                return None
+            details["attempts"] += 1
+            details["dns_provider"] = provider
+            details["address"] = address
+            began = time.monotonic()
+            try:
+                sock = _ORIGINAL_CREATE_CONNECTION((address, int(port)), timeout=min(remaining, 4.0))
+                details["tcp_ms"] += round((time.monotonic()-began)*1000)
+                return sock
+            except OSError as exc:
+                details["tcp_ms"] += round((time.monotonic()-began)*1000)
+                failures.append(exc)
+        return None
+
+    socket_result = attempt(candidate_ips, primary)
+    if socket_result is not None:
