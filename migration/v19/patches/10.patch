+    with _USER_PROXY_LOCK:
+        changed = _PROXY_ONLY_HOSTS != hosts
+        _PROXY_ONLY_HOSTS = hosts
+    if changed:
+        app_logger.info("NETWORK | selected upstream proxy hosts count=%s", len(hosts))
+    return changed
