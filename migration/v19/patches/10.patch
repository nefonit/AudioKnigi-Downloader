+def proxy_for_host(host: str) -> bool:
+    """Whether this target must traverse the configured upstream proxy."""
+    host = str(host or "").strip().casefold().rstrip(".")
+    with _USER_PROXY_LOCK:
+        if not _USER_PROXY:
