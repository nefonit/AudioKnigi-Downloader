+        if (_PROXY_SERVER is not None and proxy_host in {"localhost", "127.0.0.1", "::1"}
+                and proxy_port == _PROXY_SERVER.server_address[1]):
+            raise OSError("Прокси указывает на внутренний прокси программы")
