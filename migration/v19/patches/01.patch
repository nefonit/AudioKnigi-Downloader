+    def _download_hls_to_mp3(self, url, target, referer):
+        """Transcode a permitted plain HLS audio stream into the existing MP3 flow.
+
+        HLS is not byte-range-resumable like MP3. On restart a stale .part is
+        replaced. This implementation does not override DRM/access restrictions.
+        """
+        self._check_cancel()
+        ffmpeg = resolve_executable("ffmpeg")
+        if not ffmpeg:
+            raise RuntimeError("Для HLS источника необходим FFmpeg.")
+        target = Path(target)
+        part = target.with_name(target.name + ".part")
+        target.parent.mkdir(parents=True, exist_ok=True)
+        try:
+            part.unlink(missing_ok=True)
+        except OSError as exc:
+            raise RuntimeError(f"Не удалось подготовить временный HLS-файл: {exc}") from exc
+        headers = f"User-Agent: {USER_AGENT}\r\n"
+        if referer:
+            headers += f"Referer: {referer}\r\n"
+        cmd = [ffmpeg, "-nostdin", "-hide_banner", "-loglevel", "error", "-y"]
+        if urlsplit(str(url)).scheme in ("http", "https"):
+            cmd.extend(["-headers", headers])
+        cmd += [
+            "-i", str(url),
+            "-map", "0:a:0", "-vn", "-c:a", "libmp3lame",
+            "-b:a", "160k", "-f", "mp3", str(part),
+        ]
+        self.set_status("Обрабатываю HLS-аудиопоток через FFmpeg…")
+        proc = None
+        import tempfile
+        try:
+            with tempfile.TemporaryFile(mode="w+b") as err_file:
+                proc = subprocess.Popen(
+                    cmd, stdin=subprocess.DEVNULL, stdout=subprocess.DEVNULL,
+                    stderr=err_file, shell=False, **hidden_subprocess_kwargs(),
+                )
+                self._register_active_subprocess(proc)
+                while proc.poll() is None:
+                    self._check_cancel()
+                    try:
+                        proc.wait(timeout=0.2)
+                    except subprocess.TimeoutExpired:
+                        pass
+                self._check_cancel()
+                if proc.returncode != 0:
+                    err_file.seek(0)
+                    detail = err_file.read()[-2400:].decode("utf-8", errors="replace")
+                    raise RuntimeError("FFmpeg не смог прочитать HLS: " + (detail.strip() or str(proc.returncode)))
+            if not part.exists() or part.stat().st_size == 0:
+                raise RuntimeError("FFmpeg завершился без сохранённого MP3.")
+            os.replace(part, target)
+            return target
+        except BaseException:
+            if proc is not None and proc.poll() is None:
+                proc.kill()
+                proc.wait()
+            part.unlink(missing_ok=True)
+            raise
+        finally:
+            self._unregister_active_subprocess(proc)
+
