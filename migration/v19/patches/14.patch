 def _clean(text) -> str:
     return re.sub(r"\s+", " ", html.unescape(str(text or ""))).strip()
+
+
+# Search-engine metadata on Akniga is not the book synopsis.  It often starts
+# with "Аудиокнига «...», читает ... Слушайте бесплатно онлайн." and can be
+# truncated. Prefer the visible Description section, then clean the metadata.
+_SEO_INTRO_RE = re.compile(
+    r"^Аудиокнига\s+[«\"'„]?.{1,220}?(?:[»\"'“])?\s*,?\s*"
+    r"читает\s+[^.!?]{1,150}\.\s*Слушайте\s+бесплатно\s+онлайн[.!?]?\s*",
+    re.I,
+)
+
+
+def _strip_akniga_seo(text: str) -> str:
+    value = _clean(text)
+    # Prefix removal is intentionally anchored: ordinary prose after the
+    # promotional sentence is kept verbatim, and prose containing the same
+    # words later is never modified.
+    return _SEO_INTRO_RE.sub("", value, count=1).strip()
+
+
+def _description_from_page(page_html: str) -> str:
+    """Read the *visible* book annotation rather than SEO <meta> content.
+
+    Akniga has used several page layouts. A semantic description block is
+    safest, followed by an explicit 'Описание' heading and its nearest body.
+    Import BeautifulSoup here so the pure metadata decoder can still load in
+    minimal environments that omit the optional HTML parser dependency.
+    """
+    from bs4 import BeautifulSoup, Tag
+
+    soup = BeautifulSoup(page_html or "", "html.parser")
+    for unwanted in soup.select("script, style, noscript, template"):
+        unwanted.decompose()
+
+    def readable(node) -> str:
+        if not isinstance(node, Tag):
+            return ""
+        value = _strip_akniga_seo(node.get_text(" ", strip=True))
+        return re.sub(r"^Описание\s*(?::|[–—])?\s+", "", value, count=1, flags=re.I)
+
+    selectors = (
+        "[itemprop='description']", "#book-description", ".book-description",
+        ".book__description", ".book_description", ".book-description-text",
+        ".book__annotation", ".book-annotation", ".book-desc",
+        ".book__text", ".book-text", ".book-info__description",
+    )
+    for selector in selectors:
+        for el in soup.select(selector):
+            value = readable(el)
+            if len(value) >= 20 and value.casefold() != "описание":
+                return value
+
+    for string in soup.find_all(string=lambda item: bool(item and item.strip().casefold().strip(":") == "описание")):
+        label = string.parent
+        if not isinstance(label, Tag):
+            continue
+        # Headings can be standalone siblings or wrapped in a header div.
+        for parent in (label, label.parent):
+            if not isinstance(parent, Tag):
+                continue
+            parts = []
+            for sibling in parent.next_siblings:
+                if not isinstance(sibling, Tag):
+                    continue
+                if sibling.name in ("h1", "h2", "h3", "h4", "h5", "h6"):
+                    break
+                value = readable(sibling)
+                if value.casefold().startswith((
+                    "добавлено ", "комментарии", "рейтинг", "похожие книги",
+                )):
+                    break
+                if value and value.casefold() != "описание":
+                    parts.append(value)
+                if sum(len(part) for part in parts) >= 8000:
+                    break
+            collected = _clean(" ".join(parts))
+            if len(collected) >= 20:
+                return collected
+    return ""
+
+
+def _akniga_description(page_html: str) -> str:
+    visible = _description_from_page(page_html)
+    if visible:
+        return visible
+    return _strip_akniga_seo(_meta_value(page_html, "og:description", "description"))
 
 
